{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "api.main:app",
      "buildCommand": "python -m scripts.precompute_coverage",
      "functions": {
        "api/main.py": {
          "includeFiles": "build/coverage.json"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
